            "layout": {
                "line-cap": "round",
                "line-join": "round"
            },
            "paint": {
                "line-color": "#b8b1a7",
                "line-opacity": 0.45,
                "line-dasharray": [2, 2],
                "line-width": [
                    "interpolate",
                    ["linear"],
                    ["zoom"],
