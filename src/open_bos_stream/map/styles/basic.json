                        "motorway",
                        "trunk",
                        "primary",
                        "secondary",
                        "tertiary",
                        "minor",
                        "service",
                        "track",
                        "path"
                    ],
                    true,
                    false
                ],
                ["==", ["get", "brunnel"], "tunnel"]
