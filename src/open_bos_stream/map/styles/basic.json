{
    "version": 8,
    "name": "Open BOS Stream Basic",
    "glyphs": "/api/map/glyphs/{fontstack}/{range}.pbf",
    "sources": {},
    "layers": [
        {
            "id": "background",
            "type": "background",
            "paint": {
                "background-color": "#e9e5dc"
            }
        },
        {
            "id": "landcover",
            "type": "fill",
            "source": "openbos",
            "source-layer": "landcover",
            "paint": {
                "fill-color": "#dce8cf",
                "fill-opacity": 0.65
            }
        },
        {
            "id": "landuse",
            "type": "fill",
            "source": "openbos",
            "source-layer": "landuse",
            "paint": {
                "fill-color": "#e4dfd2",
                "fill-opacity": 0.55
            }
        },
		{
		    "id": "park",
		    "type": "fill",
		    "source": "openbos",
		    "source-layer": "landuse",
		    "filter": [
		        "match",
		        ["get", "class"],
		        ["park", "garden"],
		        true,
		        false
		    ],
		    "paint": {
		        "fill-color": "#cfe6b8",
		        "fill-opacity": 0.65
		    }
		},
		{
		    "id": "forest",
		    "type": "fill",
		    "source": "openbos",
		    "source-layer": "landcover",
		    "filter": [
		        "match",
		        ["get", "class"],
		        ["forest", "wood"],
		        true,
		        false
		    ],
		    "paint": {
		        "fill-color": "#b6d49f",
		        "fill-opacity": 0.70
		    }
		},
		{
		    "id": "grass",
		    "type": "fill",
		    "source": "openbos",
		    "source-layer": "landcover",
