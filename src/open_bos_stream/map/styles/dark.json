{
    "version": 8,
    "name": "Open BOS Stream Dark",
    "glyphs": "/api/map/glyphs/{fontstack}/{range}.pbf",
    "sources": {},
    "layers": [
        {
            "id": "background",
            "type": "background",
            "paint": {
                "background-color": "#101215"
            }
        },
        {
            "id": "landcover",
            "type": "fill",
            "source": "openbos",
            "source-layer": "landcover",
            "paint": {
                "fill-color": "#18211d",
                "fill-opacity": 0.75
            }
        },
        {
            "id": "landuse",
            "type": "fill",
            "source": "openbos",
            "source-layer": "landuse",
            "paint": {
                "fill-color": "#202326",
                "fill-opacity": 0.65
            }
        },
		{
		    "id": "park",
		    "type": "fill",
		    "source": "openbos",
		    "source-layer": "landuse",
		    "filter": [
		        "match",
		        ["get", "class"],
		        ["park", "garden"],
		        true,
		        false
		    ],
		    "paint": {
		        "fill-color": "#294030",
		        "fill-opacity": 0.70
		    }
		},
		{
		    "id": "forest",
