[Unit]
Description=Open BOS Local Display
Wants=seatd.service
After=seatd.service open-bos-stream.service
StartLimitIntervalSec=0

[Service]
Type=simple

User=streampi
Group=video

WorkingDirectory=/opt/open-bos-stream
RuntimeDirectory=open-bos-display
RuntimeDirectoryMode=0700

Environment=XDG_RUNTIME_DIR=/run/open-bos-display
Environment=XDG_SESSION_TYPE=wayland
Environment=XDG_CURRENT_DESKTOP=labwc
Environment=LIBSEAT_BACKEND=seatd
Environment=WLR_LIBINPUT_NO_DEVICES=1

ExecStart=/usr/bin/dbus-run-session -- \
    /opt/open-bos-stream/.venv/bin/python \
    -m open_bos_stream.display.runner

Restart=on-failure
RestartSec=3
TimeoutStopSec=10
KillMode=control-group

StandardOutput=journal
StandardError=journal
